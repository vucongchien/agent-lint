{
  "name": "agent-lint",
  "version": "0.1.0",
  "description": "CLI tool for linting and auto-syncing i18n & design tokens for React/Next.js with AI Agent support",
  "type": "module",
  "bin": {
    "agent-lint": "./dist/bin.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "scripts": {
    "build": "tsup src/index.ts src/bin.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts src/bin.ts --format esm --dts --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@agent-lint/core": "workspace:*",
    "commander": "^13.1.0",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {}
}
